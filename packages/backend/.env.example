PORT=3001

# JWT secrets — use strong random values (≥32 chars). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# SQLite database path
DB_PATH=./data/megabrain.db

# Admin user (optional — only for initial seeding)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@megabrain.ru

# CORS origins in production (comma-separated)
CORS_ORIGIN=
