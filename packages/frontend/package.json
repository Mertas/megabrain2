{
  "name": "frontend",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cosmos": "cosmos",
    "cosmos:build": "cosmos-export",
    "test:e2e": "npm run seed:test-users --prefix ../backend && cypress open",
    "test:e2e:run": "cypress run",
    "test:e2e:seed": "npm run seed:test-users -w ../backend",
    "test:auth": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/01-auth.cy.ts\"",
    "test:game": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/02-solo-game.cy.ts\"",
    "test:pvp": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/03-pvp.cy.ts\"",
    "test:blitz": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/04-blitz.cy.ts\"",
    "test:survival": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/05-survival.cy.ts\"",
    "test:public": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/06-home-public.cy.ts\"",
    "test:powerups": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/07-powerups.cy.ts\"",
    "test:users": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/08-users-profile.cy.ts\"",
    "test:ratings": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/09-ratings.cy.ts\"",
    "test:blitz-full": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/10-blitz-full-game.exclude.cy.ts\"",
    "test:pvp-full": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/11-pvp-full-game.exclude.cy.ts\"",
    "test:auth-password": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/10-auth-password.cy.ts\"",
    "test:admin": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/11-admin-questions.cy.ts\"",
    "test:profile-edit": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/12-profile-edit.cy.ts\"",
    "test:powerups-buy": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/13-powerups-buy.cy.ts\"",
    "test:not-found": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/14-not-found.cy.ts\"",
    "test:config": "npm run seed:test-users --prefix ../backend && cypress run --spec \"cypress/e2e/15-game-config.cy.ts\"",
    "test:all": "npm run seed:test-users --prefix ../backend && cypress run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-store": "^0.11.0",
    "msw": "^2.14.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0",
    "socket.io-client": "^4.8.3",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^6.0.2",
    "cypress": "^15.18.0",
    "oxlint": "^1.69.0",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
