#!/bin/bash
# post-receive — выкладка Megabrain2 на https://megabrain.mertas.space
# Ставить: /srv/megabrain.git/hooks/post-receive, затем chmod +x.
# Весь вывод уходит в терминал того, кто сделал git push.
set -euo pipefail

BASE=/srv/megabrain
REPO=/srv/megabrain.git
SHARED=$BASE/shared
KEEP=2
PORT=3042

log() { echo "[deploy] $*"; }

while read -r _old new ref; do
  [ -z "${new:-}" ] && continue
  case "$ref" in
    refs/heads/*) ;;
    *) log "пропускаю $ref"; continue ;;
  esac

  N="$(date +%Y%m%d-%H%M%S)-$(git --git-dir="$REPO" rev-parse --short "$new")"
  REL="$BASE/releases/$N"
  mkdir -p "$REL"

  log "релиз $N: распаковываю код (LF из индекса — git archive)"
  git --git-dir="$REPO" archive "$new" | tar -x -C "$REL"

  # вечное живёт вне релиза: база и секреты деплой не трогает
  ln -sfn "$SHARED/data" "$REL/data"
  if [ -f "$SHARED/.env" ]; then
    cp "$SHARED/.env" "$REL/packages/backend/.env"
  else
    log "ВНИМАНИЕ: нет $SHARED/.env — сервер поднимется без JWT-секретов (в production это фатально)"
  fi

  cd "$REL"
  # на сервере браузерные тесты не гоняются — бинарь Cypress (~200 МБ) не качаем
  export CYPRESS_INSTALL_BINARY=0
  log "ставлю зависимости (первый раз это долго)"
  npm ci --no-audit --no-fund

  log "сборка (tsc + vite)"
  npm run build

  PREV="$(readlink -f "$BASE/current" 2>/dev/null || true)"
  ln -sfn "$REL" "$BASE/current"
  log "перезапускаю сервис"
  sudo systemctl restart megabrain

  ok=0
  for _ in $(seq 1 20); do
    if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/api/health" >/dev/null; then ok=1; break; fi
    sleep 1
  done

  if [ "$ok" != "1" ]; then
    log "СЕРВИС НЕ ОТВЕЧАЕТ — откатываюсь на предыдущий релиз"
    if [ -n "$PREV" ] && [ -d "$PREV" ]; then
      ln -sfn "$PREV" "$BASE/current"
      sudo systemctl restart megabrain
      log "откат на $PREV"
    fi
    exit 1
  fi

  log "готово: $N — health-check пройден"
  ls -1dt "$BASE"/releases/*/ 2>/dev/null | tail -n +"$((KEEP + 1))" | xargs -r rm -rf
done

log "деплой завершён"
